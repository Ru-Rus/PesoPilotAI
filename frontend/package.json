{
  "name": "pesopilot-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-local-certificate.mjs",
    "dev": "next dev --hostname localhost --port 3010 --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem",
    "build": "next build",
    "start": "next start --hostname localhost --port 3010",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint app proxy.ts tests e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
