API_LIMIT=120
RATE_WINDOW_SECONDS=60

AUDIT_RETENTION_DAYS=90
AI_LIMIT=20
OLLAMA_URL=
OLLAMA_MODEL=
MODEL_TIMEOUT_SECONDS=10
