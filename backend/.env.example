APP_ENV=development
DATABASE_URL=mssql+pyodbc://pesopilot_app:CHANGE_ME@localhost:1433/PesoPilot?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes # pragma: allowlist secret -- documentation placeholder only
FRONTEND_URL=https://localhost:3010
OIDC_ISSUER=http://localhost:8080/realms/pesopilot
